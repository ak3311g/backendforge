{
  "name": "@ak3311g/backendforge",
  "version": "0.2.1",
  "type": "module",
  "description": "Production-ready backend generator",
  "main": "dist/index.js",
  "bin": {
    "backendforge": "./dist/index.js",
    "create-backendforge": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "registry"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && copyfiles -u 0 \"templates/**/*\" \"registry/**/*\" dist/",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "fs-extra": "^11.2.0",
    "giget": "^3.3.1",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "copyfiles": "^2.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "cli",
    "backend",
    "generator",
    "scaffolding",
    "fastify",
    "express"
  ],
  "author": "",
  "license": "MIT"
}
